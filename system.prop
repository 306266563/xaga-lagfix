# 澎湃OS2 无响应/卡顿优化 · 系统属性注入
# Redmi Note 11T Pro (xaga) / 6GB / HyperOS 2 / APatch
# 挂载式模块, 只写属性不改分区, 删模块即恢复

# ---------- lmkd ----------
# 六档单位是页(4KB), 对应 oom_score_adj 0/100/200/250/900/950。保持原厂:
# 曾放大 2-5 倍, 6GB 机器空不出那么多, lmkd 一直按最高档杀, 杀了又被拉起。
ro.lmk.minfree_levels=18432:0,23040:100,27648:200,32256:250,55296:900,80640:950
ro.lmk.enhance_batch_kill=false
# 100→150: 给卡在回收里的进程更多响应时间
ro.lmk.kill_timeout_ms=150
# false: 盯 PSI(/proc/pressure/memory), 真卡了才杀; true: 死守 minfree 水位
ro.lmk.use_minfree_levels=false
# swap 低水位 40→20: 减少过早触发回收
ro.lmk.swap_free_low_percentage=20
# 源头值: 原厂 100 会被 daemon 拉回 120, 压到 60
sys.mem.swappiness_on_launcher=60
sys.mem.swappiness_on_start=60

# ---------- 冻结 / 编译 ----------
# privapp 权限白名单违规: 从崩溃降级为记日志
ro.control_privapp_permissions=log
# 关后台 dex2oat, 避免重编译抢内存
pm.dexopt.bg-dexopt=verify
pm.dexopt.first-boot=verify
pm.dexopt.boot=verify
pm.dexopt.install=verify
pm.dexopt.inactive=verify
pm.dexopt.ab-ota=verify

# ---------- 渲染 / 输入 ----------
debug.sf.disable_backpressure=1
debug.hwui.force_gpu_rendering=true
windowsmgr.max_events_per_sec=180
